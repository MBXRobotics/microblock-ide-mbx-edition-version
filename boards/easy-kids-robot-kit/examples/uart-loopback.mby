{"config.json":"{\"mode\":\"block\",\"github\":null,\"board\":\"easy-kids-robot-kit\",\"level\":\"Beginner\"}","note.json":"[]","main.xml":"<xml xmlns=\"https://developers.google.com/blockly/xml\">\n  <variables>\n    <variable id=\"mbxUartCountVar01\">count</variable>\n  </variables>\n  <block type=\"controls_on_start\" deletable=\"false\" movable=\"false\" editable=\"false\" x=\"0\" y=\"0\">\n    <statement name=\"block\">\n      <block type=\"serial_begin_rxtx\">\n        <field name=\"RX\">A1</field>\n        <field name=\"TX\">A0</field>\n        <field name=\"BAUD\">115200</field>\n        <next>\n          <block type=\"variables_set\">\n            <field name=\"VAR\" id=\"mbxUartCountVar01\">count</field>\n            <value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow></value>\n          </block>\n        </next>\n      </block>\n    </statement>\n    <next>\n      <block type=\"controls_forever_no_connect\" deletable=\"false\" movable=\"false\" editable=\"false\">\n        <statement name=\"block\">\n          <block type=\"variables_set\">\n            <field name=\"VAR\" id=\"mbxUartCountVar01\">count</field>\n            <value name=\"VALUE\">\n              <block type=\"math_arithmetic\">\n                <field name=\"OP\">ADD</field>\n                <value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"mbxUartCountVar01\">count</field></block></value>\n                <value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n              </block>\n            </value>\n            <next>\n              <block type=\"serial_send\">\n                <value name=\"VALUE\"><shadow type=\"math_number\"><field name=\"NUM\">50</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"mbxUartCountVar01\">count</field></block></value>\n                <next>\n                  <block type=\"controls_wait\">\n                    <value name=\"time\"><shadow type=\"math_number\"><field name=\"NUM\">0.1</field></shadow></value>\n                    <next>\n                      <block type=\"print\">\n                        <value name=\"value\">\n                          <shadow type=\"text\"><field name=\"TEXT\">Hello, world!</field></shadow>\n                          <block type=\"serial_read_auto\"></block>\n                        </value>\n                        <next>\n                          <block type=\"controls_wait\">\n                            <value name=\"time\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow></value>\n                          </block>\n                        </next>\n                      </block>\n                    </next>\n                  </block>\n                </next>\n              </block>\n            </next>\n          </block>\n        </statement>\n      </block>\n    </next>\n  </block>\n</xml>"}