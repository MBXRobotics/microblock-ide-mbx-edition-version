{
  "name": "mblock-mbx",
  "version": "3.0.1",
  "description": "Microblock IDE (MBX Edition) - offline version",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "install": "electron-rebuild -f -w \"wifi-control\"",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "release:win": "electron-builder --win --x64 --publish always",
    "dist:mac": "chmod +x bin/arduino-cli/arduino-cli bin/esptool/esptool && electron-builder --mac --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microBlock-IDE/microBlock-IDE-offline.git"
  },
  "author": "microBlock",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/microBlock-IDE/microBlock-IDE-offline/issues"
  },
  "homepage": "https://github.com/microBlock-IDE/microBlock-IDE-offline#readme",
  "devDependencies": {
    "check-dependencies": "1.1.0",
    "electron": "9.2.0",
    "electron-builder": "22.9.1",
    "electron-rebuild": "^2.3.5"
  },
  "dependencies": {
    "bcrypt": "5.0.0",
    "dive": "0.5.0",
    "electron-updater": "4.3.5",
    "node-disk-info": "1.1.0",
    "node-wifi": "2.0.14",
    "serialport": "9.0.1"
  },
  "build": {
    "appId": "com.microblock.mbx",
    "productName": "Microblock IDE (MBX Edition)",
    "publish": [
      {
        "provider": "github",
        "owner": "MBXRobotics",
        "repo": "microblock-ide-mbx-edition-version",
        "releaseType": "release"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "files": [
      "!Arduino/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/favicon.ico",
      "artifactName": "Microblock-IDE-MBX-Edition-Setup-${version}-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Microblock IDE (MBX Edition)"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/favicon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "artifactName": "Microblock-IDE-MBX-Edition-${version}-mac-x64.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/favicon.png",
      "category": "Development"
    },
    "fileAssociations": [
      {
        "ext": "mby",
        "name": "MBY",
        "description": "microBlock project file",
        "icon": "build/favicon.ico",
        "role": "Editor"
      }
    ]
  },
  "postinstall": "electron-builder install-app-deps"
}
